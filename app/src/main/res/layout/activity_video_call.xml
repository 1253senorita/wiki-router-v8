<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- 1. 상대방 영상 화면 (전체 화면 배경) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 상대방 화면이 연결되기 전 안내 문구 (선택 사항) -->
    <TextView
        android:id="@+id/tvRemoteWait"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="상대방 영상 연결 대기 중..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. 내 영상 화면 (우측 상단 썸네일 형태, 카드뷰로 모서리 둥글게 처리) -->
    <androidx.cardview.widget.CardView
        android:layout_width="110dp"
        android:layout_height="160dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#333333"
        app:cardCornerRadius="12dp"
        app:cardPreventCornerOverlap="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 내 카메라 화면 렌더러 -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.cardview.widget.CardView>

    <!-- 3. 하단 컨트롤 버튼 바 (음소거, 통화 종료, 영상 켜기/끄기) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 마이크 음소거 버튼 -->
        <Button
            android:id="@+id/btnToggleMic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="#444444"
            android:text="🎤"
            app:cornerRadius="30dp" />

        <!-- 통화 종료 버튼 (빨간색) -->
        <Button
            android:id="@+id/btnEndCall"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:backgroundTint="#E53935"
            android:text="📞"
            app:cornerRadius="35dp" />

        <!-- 비디오 켜기/끄기 버튼 -->
        <Button
            android:id="@+id/btnToggleVideo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="24dp"
            android:backgroundTint="#444444"
            android:text="📷"
            app:cornerRadius="30dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>