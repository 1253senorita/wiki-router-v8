<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 상단 아이콘 영역 (검색, 더보기) -->
    <ImageView
        android:id="@+id/icMore"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_more"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/icSearch"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_search"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="@+id/icMore"
        app:layout_constraintBottom_toBottomOf="@+id/icMore"
        app:layout_constraintEnd_toStartOf="@+id/icMore" />

    <!-- 입력된 번호가 표시될 영역 -->
    <TextView
        android:id="@+id/tvInputNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="36sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/gridLayoutDialer" />

    <!-- 다이얼 패드 그리드 -->
    <GridLayout
        android:id="@+id/gridLayoutDialer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/btnCall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="1" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 2 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="2" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ABC" android:textSize="12sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 3 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="3" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="DEF" android:textSize="12sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 4 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="4" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ㄱㅋ\nGHI" android:gravity="center" android:textSize="10sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 5 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="5" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ㄴㄹ\nJKL" android:gravity="center" android:textSize="10sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 6 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="6" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ㄷㅌ\nMNO" android:gravity="center" android:textSize="10sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 7 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="7" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ㅂㅍ\nPQRS" android:gravity="center" android:textSize="10sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 8 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="8" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ㅅㅎ\nTUV" android:gravity="center" android:textSize="10sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 9 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="9" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ㅈㅊ\nWXYZ" android:gravity="center" android:textSize="10sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- * -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="*" android:textSize="48sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 0 -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="0" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ㅇㅁ" android:textSize="12sp" android:textColor="#888888" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- # -->
        <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="100dp" android:layout_height="80dp" android:clickable="true" android:focusable="true">
            <TextView android:text="#" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </GridLayout>

    <!-- 하단 초록색 통화 버튼 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:src="@android:drawable/ic_menu_call"
        app:tint="#FFFFFF"
        app:backgroundTint="#24B35E"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>