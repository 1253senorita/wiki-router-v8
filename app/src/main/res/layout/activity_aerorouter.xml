<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/neumorphic_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- 타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AeroRouter PTT"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#4a5568"
        android:layout_marginBottom="40dp"/>

    <!-- 상태 표시 영역 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STANDBY (연결 대기중)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#718096"
        android:layout_marginBottom="60dp"/>

    <!-- 중앙 PTT 원형 무전기 버튼 -->
    <Button
        android:id="@+id/btnPtt"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/neumorphic_button_normal"
        android:text="PUSH\nTO\nTALK"
        android:textColor="#2d3748"
        android:textSize="18sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"/>

</LinearLayout>