<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/phoneFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/layoutPhoneBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutPhoneBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 키패드 탭 -->
        <LinearLayout
            android:id="@+id/tabDialer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvTabDialer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="키패드"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>
            <View
                android:id="@+id/indicatorDialer"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="#FFFFFF"/>
        </LinearLayout>

        <!-- 최근기록 탭 -->
        <LinearLayout
            android:id="@+id/tabRecent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvTabRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근기록"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>
            <View
                android:id="@+id/indicatorRecent"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <!-- 연락처 탭 -->
        <LinearLayout
            android:id="@+id/tabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvTabContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연락처"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>
            <View
                android:id="@+id/indicatorContacts"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <!-- 플레이스 탭 -->
        <LinearLayout
            android:id="@+id/tabPlace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvTabPlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="플레이스"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>
            <View
                android:id="@+id/indicatorPlace"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>