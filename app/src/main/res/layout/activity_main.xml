<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".presentation.main.MainActivity">

    <!-- 상단 컨트롤 버튼 바 -->
    <LinearLayout
        android:id="@+id/layout_button_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginTop="36dp"
        android:background="#F0F0F0"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 버튼 1: 무전기 이동 -->
        <Button
            android:id="@+id/btnOpenPtt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="무전기 이동"
            android:textSize="12sp" />

        <!-- 버튼 2: 웹 새로고침 -->
        <Button
            android:id="@+id/btnReloadWeb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="새로고침"
            android:textSize="12sp" />

        <!-- 버튼 3: 로그아웃 -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="로그아웃"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 파이어베이스 자동 빌드/테스트 봇 감지용 상태 정보 패널 -->
    <LinearLayout
        android:id="@+id/layout_test_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#EFEFEF"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_button_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 테스트 감지용 상태 텍스트 뷰 -->
        <TextView
            android:id="@+id/tvRobotTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[System Status] Clean Architecture &amp; Firebase Test Active"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:contentDescription="RobotTestStatusText" />

        <!-- 자동화 테스트 크롤링을 유도하기 위한 추가 세부 정보 텍스트 -->
        <TextView
            android:id="@+id/tvRobotTestDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="AeroRouter PTT Service and WebView Integration Ready."
            android:textSize="11sp"
            android:textColor="#666666" />

        <!-- 테스트 로봇이 클릭 이벤트를 발생시킬 수 있는 더미 액션 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnTestPing"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="테스트 핑"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTestDiagnostic"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="진단 실행"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- 플러터 웹 앱이 탑재될 메인 WebView -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_test_metadata"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>