<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FAFAFA"
    tools:context="com.teminator.mypadnoteone.presentation.main.MainActivity">

    <!-- 🔥 바로바로 배차 프래그먼트가 쏙 들어갈 빈 방(컨테이너) 영역 (평소에는 gone으로 숨김) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. 상단 앱바 -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIKI-Service"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF0000"
            android:layout_marginEnd="16dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnOpenClient"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="고객페이지"
            android:textSize="11sp"
            android:backgroundTint="#F9F5FF"
            android:textColor="#6200EE"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="로그아웃"
            android:textSize="11sp"
            android:backgroundTint="#F0F0F0"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- 2. 상단 카테고리/필터 탭 바 -->
    <HorizontalScrollView
        android:id="@+id/layout_category_scroll"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:scrollbars="none"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/layout_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <Button
                android:id="@+id/btnOpenPtt"
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:text="영상 통화"
                android:textSize="14sp"
                android:backgroundTint="#000000"
                android:textColor="#03A9F4"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnOpenMatchingRoom"
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#2E7D32"
                android:text="Match룸"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnOpenIndep"
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:text="독립 테스트"
                android:textSize="14sp"
                android:backgroundTint="#00FF5D"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnOpenMultiStream"
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:text="멀티스트림"
                android:textSize="14sp"
                android:backgroundTint="#6200EE"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. 파이어베이스 자동 빌드/테스트 봇 감지용 상태 정보 패널 -->
    <LinearLayout
        android:id="@+id/layout_test_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#EFEFEF"
        app:layout_constraintTop_toBottomOf="@+id/layout_category_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvRobotTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[System Status] Clean Architecture &amp; Firebase Test Active"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#333333" />
    </LinearLayout>

    <View
        android:id="@+id/divider_top"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@+id/layout_test_metadata"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. 메뉴 카드들이 들어갈 대시보드 영역 (ScrollView) -->
    <ScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/divider_top"
        app:layout_constraintBottom_toTopOf="@+id/layout_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 안내 텍스트 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="원하시는 메뉴를 선택해 주세요."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>




            <!-- 🚚 🚚🚚🚚🚚[메가 멀티 대시보드 카드] 이것저것 다 넣은 확장형 관제 위젯 -->
            <!-- 🚚 [프리미엄 관제 대시보드 카드] 실시간 상태 지표 포함 버전 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBaroBaroBOTT"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="#E6F2FF"
                    android:padding="16dp">

                    <!-- 상단: 타이틀 및 라이브 뱃지 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🚚 바로바로 화물 배차 관제센터"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0044AA"/>

                        <TextView
                            android:id="@+id/tvLiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● LIVE 5건 대기"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#FF3300"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>
                    </LinearLayout>

                    <!-- 중단: 현재 실시간 상태 요약 -->
                    <TextView
                        android:id="@+id/tvCardSubInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[진행중] 실시간 화물 콜 대기 목록 및 상세 배차 관리"
                        android:textSize="12sp"
                        android:textColor="#444444"
                        android:layout_marginBottom="10dp"/>

                    <!-- 📊 상태 지표 패널 (소켓 연결 및 오늘 처리 건수) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#D6E9FF"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tvSocketStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔌 소켓: 연결됨 (OK)"
                            android:textSize="11sp"
                            android:textColor="#2E7D32"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvTodayCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="오늘 완료: 12건"
                            android:textSize="11sp"
                            android:textColor="#0044AA"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- 하단: 이동 유도 텍스트 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="배차 관리실 바로가기 ➔"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0044AA"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- 🚚 🚚🚚카🚚🚚드들 (컴팩트하게 축소: 높이 75dp) -->




            <!-- 보조 카드 1 (AI 보미 관제) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWikiRouterClient"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#E8F5E9"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖 AI 보미 관제"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"/>

                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="소켓 통신 확인"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 보조 카드 2 (실시간 영상 통화) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📹 영상 통화 서비스"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="고화질 영상 통신"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- 보조 카드 3 (새 화물 오더 직접 등록) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRegisterOrder"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F9F5FF"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 새 화물 등록"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#6200EE"/>

                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신규 배차 등록"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 보조 카드 4 (파이어베이스 다운로드 및 호스팅) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFirebaseDownload"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFF8F8"
                    android:paddingHorizontal="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 파이어베이스 호스팅"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FF0000"/>
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최신 빌드 다운로드"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- 5. 하단 네비게이션 바 -->
    <LinearLayout
        android:id="@+id/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="홈"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#FF0000"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="다운로드/안내"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#606060"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="추가탭"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#606060"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="보관함"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#606060"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>