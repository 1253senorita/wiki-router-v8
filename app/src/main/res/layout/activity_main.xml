<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".presentation.main.MainActivity">

    <!-- 상단 컨트롤 버튼 바 -->
    <LinearLayout
        android:id="@+id/layout_button_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginTop="36dp"
        android:background="#F0F0F0"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnOpenPtt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="무전기 이동"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnReloadWeb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="새로고침"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="로그아웃"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 파이어베이스 자동 빌드/테스트 봇 감지용 상태 정보 패널 -->
    <LinearLayout
        android:id="@+id/layout_test_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#EFEFEF"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_button_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvRobotTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[System Status] Clean Architecture &amp; Firebase Test Active"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- 📌 경고가 나지 않도록 높이 구조를 최적화한 스크롤 영역 -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/layout_test_metadata"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 1번 메인 웹뷰 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#DDDDDD"
                    android:padding="6dp"
                    android:text="▼ 메인 서비스 WebView (10.0.2.2:8080)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#444444" />

                <WebView
                    android:id="@+id/web_view"
                    android:layout_width="match_parent"
                    android:layout_height="420dp" />
            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="#999999" />

            <!-- 2번 세컨드 웹뷰 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#DDDDDD"
                    android:padding="6dp"
                    android:text="▼ 다운로드 / 호스팅 안내 WebView (MyPadNoteOne)"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <WebView
                    android:id="@+id/web_view_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="420dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>