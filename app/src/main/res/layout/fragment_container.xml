<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 1. 무전기 진입 버튼 -->
    <Button
        android:id="@+id/btnOpenPtt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="무전기 (AeroRouter)"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

    <!-- 2. 위키 라우터 버튼 -->
    <Button
        android:id="@+id/btnWIKIPtt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Wiki 라우터"
        app:layout_constraintTop_toBottomOf="@id/btnOpenPtt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- 3. 파이어베이스 다운로드 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFirebaseDownload"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnWIKIPtt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="파이어베이스 다운로드 웹페이지 열기"
            android:textSize="16sp" />
    </androidx.cardview.widget.CardView>

    <!-- 4. 바로바로 배차 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBaroBaro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardFirebaseDownload"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="바로바로 화물 배차 화면 열기"
            android:textStyle="bold"
            android:textSize="16sp" />
    </androidx.cardview.widget.CardView>

    <!-- 5. 로그아웃 버튼 -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="로그아웃"
        app:layout_constraintTop_toBottomOf="@id/cardBaroBaro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- 🔥 6. 배차 카드 클릭 시 프래그먼트가 덮어씌워질 컨테이너 영역 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>