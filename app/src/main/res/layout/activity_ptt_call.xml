<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context="com.terminator.mypadnoteone.com.teminator.mypadnoteone.video.VideoCallActivity">

    <!-- 1. 상단 타이틀 및 모드 전환 탭 영역 -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvPeerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WIKI-ROUTER HYBRID CALL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- 음성/영상 모드 즉시 전환 스위치 버튼 -->
            <ToggleButton
                android:id="@+id/btnToggleMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="#2C2C2C"
                android:textOn="📹 영상 모드"
                android:textOff="🎙️ 음성(PTT) 모드"
                android:textColor="#FF5722"
                android:textSize="11sp"
                android:paddingHorizontal="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="채팅 및 통화 파이프 연결됨"
            android:textColor="#B0BEC5"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 2. 중앙 메인 컨테이너 (ViewFlipper: 음성모드 vs 영상모드 전환) -->
    <ViewFlipper
        android:id="@+id/viewFlipperCallMode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/layout_ptt_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- [Child 0]: 음성 PTT 모드 (미니 상태바 + 카톡 스타일 채팅창) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 미니 PTT 상태 바 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_btn_speak_now"
                        app:tint="#FF5722"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tvPttState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="음성 대기중 (PTT 준비됨)"
                        android:textColor="#FF5722"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 카톡 스타일 채팅 리사이클러뷰 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardElevation="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewChat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:clipToPadding="false"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- [Child 1]: 고화질 영상 통화 모드 (상대방 전용 큰 비디오 화면) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardElevation="6dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#666666"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="28dp"
                        android:text="상대방 영상 스트림 송수신 중..."
                        android:textColor="#888888"
                        android:textSize="13sp"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

    </ViewFlipper>

    <!-- 3. 하단 무전기(PTT) 및 오디오 제어 버튼 영역 -->
    <LinearLayout
        android:id="@+id/layout_ptt_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <ToggleButton
                android:id="@+id/btnMute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#2C2C2C"
                android:textOn="음소거 끔"
                android:textOff="음소거 켬"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginEnd="20dp"/>

            <ToggleButton
                android:id="@+id/btnSpeaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#2C2C2C"
                android:textOn="스피커 끔"
                android:textOff="스피커 켬"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnPttPush"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="[누르고 말하기] PTT 송신"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnEndCall"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="통화 종료"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#424242"/>

    </LinearLayout>

    <!-- 4. 🔥 [전체 고정형 PiP 내 카메라 화면] ViewFlipper 바깥인 최상단에 배치 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMyVideoContainer"
        android:layout_width="90dp"
        android:layout_height="130dp"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#2C2C2C"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 임시로 일반 View로 변경 (빨간 줄 사라짐) -->
            <View
                android:id="@+id/myVideoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#444444"/>

            <TextView
                android:id="@+id/tvMyVideoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="내 화면"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>